{
  "name": "social-api",
  "version": "3.0.0",
  "description": "Backend API for social-api — TypeScript, Express 5, Supabase (PostgreSQL + Auth), MongoDB Atlas, and Redis Cloud, built with a layered architecture, Zod validation, and Pino logging.",
  "main": "dist/server/server.js",
  "scripts": {
    "dev": "tsx watch src/server/server.ts",
    "build": "tsc",
    "start": "node dist/server/server.js",
    "check": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "seed": "tsx seeds/seed.ts",
    "migrate:mongodb": "migrate-mongo",
    "migrate:mongodb:create": "migrate-mongo create",
    "migrate:mongodb:up": "migrate-mongo up",
    "migrate:mongodb:down": "migrate-mongo down",
    "migrate:mongodb:status": "migrate-mongo status",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:migration:new": "supabase migration new",
    "supabase:push": "supabase db push"
  },
  "keywords": [
    "social-network",
    "social-api",
    "rest-api",
    "restful",
    "express",
    "typescript",
    "nodejs",
    "backend",
    "api",
    "postgresql",
    "knex",
    "mongodb",
    "migrate-mongo",
    "redis",
    "jwt",
    "authentication",
    "rate-limiting",
    "helmet",
    "validation"
  ],
  "type": "module",
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "chalk": "^6.0.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "migrate-mongo": "^14.0.7",
    "mongoose": "^9.11.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.39",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "@swc/core@1.15.46": true,
    "esbuild@0.28.1": true,
    "unrs-resolver@1.12.2": true
  }
}
