{
  "name": "social-api",
  "version": "1.0.0",
  "description": "A RESTful social-network API built with Express, PostgreSQL, MongoDB, and Redis.",
  "main": "dist/server/server.js",
  "scripts": {
    "dev": "tsx watch src/server/server.ts",
    "build": "tsc",
    "start": "node dist/server/server.js",
    "check": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "psqlMigrate": "tsx scripts/migrate.ts",
    "seed": "tsx seeds/seed.ts",
    "knex": "tsx node_modules/knex/bin/cli.js --knexfile knexfile.ts",
    "migrate": "npm run knex -- migrate:latest",
    "migrate:rollback": "npm run knex -- migrate:rollback",
    "migrate:status": "npm run knex -- migrate:list"
  },
  "keywords": [
    "social-network",
    "social-api",
    "rest-api",
    "restful",
    "express",
    "typescript",
    "nodejs",
    "backend",
    "api",
    "postgresql",
    "knex",
    "mongodb",
    "redis",
    "jwt",
    "authentication",
    "rate-limiting",
    "helmet",
    "validation"
  ],
  "type": "module",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "chalk": "^5.6.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "mongoose": "^9.7.4",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@swc/core": "^1.15.46",
    "@swc/jest": "^0.2.39",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
