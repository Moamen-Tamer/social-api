NODE_ENV=development
SERVER_PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_DATABASE=social_api
MONGO_URI=mongodb://127.0.0.1:27017/social_api
REDIS_URL=redis://127.0.0.1:6379
ACCESS_KEY_SECRET=replace_with_a_long_random_access_secret
REFRESH_KEY_SECRET=replace_with_a_different_long_random_refresh_secret
ACCESS_KEY_EXPIRY=15m
REFRESH_KEY_EXPIRY=7d
REFRESH_TOKEN_TTL_SECONDS=604800
